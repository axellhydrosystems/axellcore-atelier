{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "axell/form-control",
	"title": "Form Control",
	"category": "text",
	"ancestor": [ "axell/form" ],
	"description": "The actual input/select/textarea of a form field — text, email, tel, number, textarea, select, checkbox, or hidden, with optional input masking (CPF/CNPJ, CEP, phone). Pair with an axell/form-label sibling (same id/for) for the visible label — see this plugin's CLAUDE.md.",
	"keywords": [ "input", "control", "field", "form" ],
	"textdomain": "axellcore-atelier",
	"attributes": {
		"type": { "type": "string", "default": "text" },
		"id": { "type": "string", "default": "" },
		"name": { "type": "string", "default": "" },
		"required": { "type": "boolean", "default": false },
		"placeholder": { "type": "string", "default": "" },
		"value": { "type": "string", "default": "" },
		"checked": { "type": "boolean", "default": false },
		"options": { "type": "array", "default": [] },
		"mask": { "type": "string", "default": "" },
		"maskSourceName": { "type": "string", "default": "" },
		"citiesSourceName": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"className": true,
		"customClassName": true,
		"spacing": {
			"margin": true,
			"padding": true,
			"__experimentalDefaultControls": { "margin": false, "padding": false }
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalFontStyle": true,
			"__experimentalLetterSpacing": true,
			"__experimentalTextTransform": true,
			"__experimentalDefaultControls": { "fontSize": true }
		},
		"color": {
			"text": true,
			"background": true,
			"gradients": true,
			"__experimentalDefaultControls": { "text": true, "background": false }
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true,
			"__experimentalDefaultControls": { "color": false, "radius": false, "style": false, "width": false }
		}
	},
	"editorScript": [ "file:./index.js", "file:./variations.js" ],
	"style": "file:./style.css"
}
