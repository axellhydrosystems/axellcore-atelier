{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "axell/form-control-br-revenue-id",
	"title": "Form Control (CPF ou CNPJ)",
	"category": "text",
	"parent": [
		"axell/form-group"
	],
	"description": "Campo de CPF ou CNPJ, com máscara brasileira.",
	"keywords": [
		"cpf",
		"cnpj",
		"documento",
		"form"
	],
	"textdomain": "axellcore-atelierclub",
	"attributes": {
		"id": {
			"type": "string",
			"default": ""
		},
		"name": {
			"type": "string",
			"default": ""
		},
		"placeholder": {
			"type": "string",
			"default": "000.000.000-00 / 00.000.000/0000-00"
		},
		"required": {
			"type": "boolean",
			"default": false
		},
		"typeField": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"className": true,
		"customClassName": true,
		"interactivity": true
	},
	"editorScript": "file:./index.js",
	"viewScriptModule": "file:./view.ts"
}
