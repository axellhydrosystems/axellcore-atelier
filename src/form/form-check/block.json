{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "axell/form-check",
	"title": "Form Check",
	"category": "text",
	"ancestor": [
		"axell/form",
		"axell/form-atelier"
	],
	"description": "A checkbox with its own label text (links allowed), such as a consent or terms acceptance. Stands alone: it does not sit in an axell/form-group.",
	"keywords": [
		"checkbox",
		"consent",
		"check",
		"form"
	],
	"textdomain": "axellcore-atelier",
	"attributes": {
		"id": {
			"type": "string",
			"default": ""
		},
		"name": {
			"type": "string",
			"default": ""
		},
		"required": {
			"type": "boolean",
			"default": false
		},
		"checked": {
			"type": "boolean",
			"default": false
		},
		"text": {
			"type": "rich-text",
			"source": "rich-text",
			"selector": "label",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"className": true,
		"customClassName": true,
		"anchor": true,
		"color": {
			"text": true,
			"link": true,
			"background": true,
			"__experimentalDefaultControls": {
				"text": true
			}
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true,
			"__experimentalDefaultControls": {
				"color": false,
				"radius": false,
				"style": false,
				"width": false
			}
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalFontStyle": true,
			"__experimentalLetterSpacing": true,
			"__experimentalTextTransform": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"__experimentalDefaultControls": {
				"margin": false,
				"padding": false
			}
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"editorStyle": "file:./index.css"
}
