{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "axell/form-control-postal",
  "title": "Form Control (CEP / ZIP)",
  "category": "text",
  "description": "CEP ou ZIP code: máscara conforme o país.",
  "keywords": [
    "endereço",
    "país",
    "estado",
    "cidade",
    "cep",
    "form"
  ],
  "textdomain": "axellcore-atelierclub",
  "attributes": {
    "id": {
      "type": "string",
      "default": ""
    },
    "name": {
      "type": "string",
      "default": "cep"
    },
    "placeholder": {
      "type": "string",
      "default": "00000-000"
    },
    "required": {
      "type": "boolean",
      "default": false
    },
    "countryField": {
      "type": "string",
      "default": "country"
    },
    "countrySource": {
      "type": "string",
      "default": "field"
    },
    "country": {
      "type": "string"
    }
  },
  "supports": {
    "html": false,
    "className": true,
    "customClassName": true,
    "interactivity": true,
    "color": {
      "text": true,
      "background": true,
      "gradients": true,
      "__experimentalDefaultControls": {
        "text": true,
        "background": false
      }
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true,
      "__experimentalDefaultControls": {
        "color": false,
        "radius": false,
        "style": false,
        "width": false
      }
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "__experimentalFontFamily": true,
      "__experimentalFontWeight": true,
      "__experimentalFontStyle": true,
      "__experimentalLetterSpacing": true,
      "__experimentalTextTransform": true,
      "__experimentalDefaultControls": {
        "fontSize": true
      }
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "__experimentalDefaultControls": {
        "margin": false,
        "padding": false
      }
    }
  },
  "editorScript": "file:./index.js",
  "viewScriptModule": "axell-form-control-country-view-script-module"
}