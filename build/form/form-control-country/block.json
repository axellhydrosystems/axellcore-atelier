{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "axell/form-control-country",
  "title": "Form Control (Country)",
  "category": "text",
  "description": "Country select: Brazil (BR), United States (US) or Other (unset).",
  "keywords": [
    "address",
    "country",
    "state",
    "city",
    "zip",
    "form"
  ],
  "textdomain": "axellcore-atelierclub",
  "attributes": {
    "id": {
      "type": "string",
      "default": ""
    },
    "name": {
      "type": "string",
      "default": "country"
    },
    "placeholder": {
      "type": "string",
      "default": ""
    },
    "required": {
      "type": "boolean",
      "default": false
    },
    "fixed": {
      "type": "string",
      "default": ""
    },
    "hiddenField": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false,
    "className": true,
    "customClassName": true,
    "interactivity": true
  },
  "editorScript": "file:./index.js",
  "viewScriptModule": "file:./view.js"
}