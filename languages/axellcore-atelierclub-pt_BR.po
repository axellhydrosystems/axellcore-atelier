msgctxt "block title"
msgid "Form Label"
msgstr "Rótulo do Formulário"

#: includes/blocks/form/form-label/block.json
msgctxt "block description"
msgid "A form field's label, associated with its axell/form-control sibling via a matching id/for pair. Can be visually hidden (still read by screen readers) via the \"Visually hidden\" toggle."
msgstr "O rótulo de um campo de formulário, associado ao axell/form-control irmão por um par id/for correspondente. Pode ficar visualmente oculto (ainda lido por leitores de tela) via o alternador \"Visualmente oculto\"."

#: includes/blocks/form/form-label/block.json
msgctxt "block keyword"
msgid "label"
msgstr "rótulo"

