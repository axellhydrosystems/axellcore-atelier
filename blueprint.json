{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"preferredVersions": { "php": "8.2", "wp": "latest" },
	"features": { "networking": true },
	"landingPage": "/atelier",
	"steps": [
		{ "step": "login", "username": "admin", "password": "password" },
		{
			"step": "setSiteOptions",
			"options": {
				"timezone_string": "America/Sao_Paulo",
				"gmt_offset": "-3",
				"date_format": "d/m/Y",
				"time_format": "H:i",
				"start_of_week": "1"
			}
		},
		{ "step": "setSiteLanguage", "language": "pt_BR" },
		{
			"step": "unzip",
			"zipFile": {
				"resource": "url",
				"url": "https://github.com/axellhydrosystems/axellcore-atelier/releases/download/0.7.0/axellcore-atelier.0.7.0-pt_BR.zip"
			},
			"extractToPath": "/wordpress/wp-content/languages/plugins"
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/camaleaun/wp-kses-svg/releases/download/0.1.0/wp-kses-svg.0.1.0.zip"
			},
			"options": { "activate": true }
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/camaleaun/camaleaunmail/releases/download/0.3.0/camaleaunmail.0.3.0.zip"
			},
			"options": { "activate": true }
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/axellhydrosystems/axellcore-atelier/releases/download/0.7.0/axellcore-atelier.0.7.0.zip"
			},
			"options": { "activate": true }
		},
		{
			"step": "runPHP",
			"code": "<?php require '/wordpress/wp-load.php'; global $wp_rewrite; $wp_rewrite->set_permalink_structure( '/%postname%/' ); $wp_rewrite->flush_rules();"
		}
	]
}
