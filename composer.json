{
	"name": "axell/axellcore-atelierclub",
	"description": "Atelier Axell Club — self-contained invite-club landing page (FSE template + core blocks + a custom application-form block).",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.0",
		"brain/monkey": "^2.6",
		"phpstan/phpstan": "^1.10",
		"szepeviktor/phpstan-wordpress": "^1.3",
		"squizlabs/php_codesniffer": "^3.9",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"autoload-dev": {
		"psr-4": {
			"Axellcore_Atelierclub\\Tests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"test": "phpunit --no-coverage",
		"analyse": "phpstan analyse --memory-limit=2G",
		"lint": "phpcs",
		"lint:fix": "phpcbf"
	}
}
