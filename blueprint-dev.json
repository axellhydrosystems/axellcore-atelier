{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"preferredVersions": { "php": "8.2", "wp": "latest" },
	"features": { "networking": true },
	"landingPage": "/atelier",
	"steps": [
		{ "step": "login", "username": "admin", "password": "password" },
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/camaleaun/wp-kses-svg/releases/download/0.1.0/wp-kses-svg.0.1.0.zip"
			},
			"options": { "activate": true }
		},
		{
			"step": "installPlugin",
			"pluginZipFile": {
				"resource": "github.com",
				"owner": "axellhydrosystems",
				"repo": "axellcore-atelierclub",
				"workflow": {
					"id": "pr-preview-build.yml",
					"artifactName": "plugin-zip"
				}
			},
			"options": { "activate": true }
		},
		{
			"step": "runPHP",
			"code": "<?php require '/wordpress/wp-load.php'; global $wp_rewrite; $wp_rewrite->set_permalink_structure( '/%postname%/' ); $wp_rewrite->flush_rules();"
		}
	]
}
